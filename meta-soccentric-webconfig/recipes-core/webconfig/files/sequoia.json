{
  "platform": "sequoia",
  "model": "x86_64-sbc",
  "board_name": "Intel/AMD x86 SBC (Sequoia) — UEFI, PREEMPT_RT/hypervisor",
  "has_rtc": true,
  "has_tpm": true,
  "secure_boot": true,
  "service_allowlist": [
    "sshd.service",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "webconfigd.service",
    "nginx.service",
    "redis-server.service"
  ],
  "peripherals": [
    { "id": "can0", "device": "can0", "human_name": "CAN channel 0 (PCAN-USB)", "kind": "can", "caps": { "fd": true } },
    { "id": "ttyS0", "device": "/dev/ttyS0", "human_name": "16550 UART 0", "kind": "serial", "caps": { "modes": ["rs232"] } },
    { "id": "ttyUSB0", "device": "/dev/ttyUSB0", "human_name": "USB-serial adapter", "kind": "serial", "caps": { "modes": ["rs232", "rs485"] } },
    { "id": "i2c-0", "device": "/dev/i2c-0", "human_name": "SMBus / I2C bus 0", "kind": "i2c", "caps": {} },
    { "id": "spi0", "device": "/dev/spidev0.0", "human_name": "SPI bus 0 (LPSS)", "kind": "spi", "caps": {} },
    { "id": "gpio-led-status", "device": "gpiochip0 line 0", "human_name": "Status LED", "kind": "gpio", "caps": { "direction": "out" } },
    { "id": "thermal-zone-0", "device": "/sys/class/thermal/thermal_zone0", "human_name": "x86 core thermal zone", "kind": "thermal", "caps": { "throttle": true } },
    { "id": "thermal-zone-1", "device": "/sys/class/thermal/thermal_zone1", "human_name": "Package thermal zone", "kind": "thermal", "caps": { "throttle": true } },
    { "id": "eth0", "device": "enp1s0", "human_name": "Ethernet 0", "kind": "net", "caps": {} },
    { "id": "eth1", "device": "enp2s0", "human_name": "Ethernet 1", "kind": "net", "caps": {} },
    { "id": "wlan0", "device": "wlp3s0", "human_name": "Wi-Fi", "kind": "net", "caps": { "ap": false } }
  ],
  "dashboard_tiles": [
    { "id": "thermal", "title": "Core temperature", "metrics": ["thermal.temp", "thermal.throttled"], "render": "sparkline" },
    { "id": "net", "title": "Ethernet links", "metrics": ["net.eth0", "net.eth1"], "render": "state" }
  ]
}