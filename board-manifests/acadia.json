{
  "platform": "acadia",
  "model": "raspberrypi-cm4",
  "board_name": "Raspberry Pi CM4/CM5 (Acadia) — lowest-resource target",
  "has_rtc": false,
  "has_tpm": false,
  "secure_boot": false,
  "service_allowlist": [
    "sshd.service",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "webconfigd.service",
    "pigpiod.service",
    "iwd.service"
  ],
  "peripherals": [
    { "id": "can0", "device": "can0", "human_name": "CAN channel 0 (MCP2515 via SPI)", "kind": "can", "caps": { "fd": false } },
    { "id": "ttyAMA0", "device": "/dev/ttyAMA0", "human_name": "Primary UART (GPIO 14/15)", "kind": "serial", "caps": { "modes": ["rs232"], "console_default": true } },
    { "id": "ttyS0", "device": "/dev/ttyS0", "human_name": "Mini UART", "kind": "serial", "caps": { "modes": ["rs232"] } },
    { "id": "i2c-1", "device": "/dev/i2c-1", "human_name": "I2C bus 1", "kind": "i2c", "caps": {} },
    { "id": "i2c-0", "device": "/dev/i2c-0", "human_name": "I2C bus 0 (HAT ID EEPROM)", "kind": "i2c", "caps": {} },
    { "id": "spi0", "device": "/dev/spidev0.0", "human_name": "SPI bus 0 (CE0)", "kind": "spi", "caps": {} },
    { "id": "spi1", "device": "/dev/spidev0.1", "human_name": "SPI bus 0 (CE1)", "kind": "spi", "caps": {} },
    { "id": "gpio-led-act", "device": "gpiochip0 line 42", "human_name": "Activity LED", "kind": "gpio", "caps": { "direction": "out", "active_low": true } },
    { "id": "gpio-btn-recovery", "device": "gpiochip0 line 5", "human_name": "Recovery button (GPIO5)", "kind": "gpio", "caps": { "direction": "in", "active_low": true } },
    { "id": "mcu-picow", "device": "/dev/ttyACM0", "human_name": "Pico W companion (RP2040)", "kind": "mcu", "caps": { "protocol": "soccentric-mcu", "signed_fw": true, "settings_schema": "app:mcu-picow" } },
    { "id": "thermal-zone-0", "device": "/sys/class/thermal/thermal_zone0", "human_name": "SoC thermal zone", "kind": "thermal", "caps": { "throttle": true } },
    { "id": "eth0", "device": "eth0", "human_name": "Ethernet 0", "kind": "net", "caps": {} },
    { "id": "wlan0", "device": "wlan0", "human_name": "Wi-Fi (CM4+WL)", "kind": "net", "caps": { "ap": true } }
  ],
  "dashboard_tiles": [
    { "id": "mcu", "title": "Pico W heartbeat", "metrics": ["mcu.heartbeat", "mcu.fw_version"], "render": "state" },
    { "id": "thermal", "title": "SoC temperature", "metrics": ["thermal.temp"], "render": "sparkline" },
    { "id": "memory", "title": "Memory (1 GB SKU watch)", "metrics": ["mem.available", "mem.total"], "render": "bar" }
  ],
  "default_alert_rules": [
    { "id": "disk-full", "enabled": true, "metric": "disk.pct", "comparison": ">", "threshold": 90, "duration_secs": 60, "actions": ["ui"] },
    { "id": "watchdog-reset", "enabled": true, "metric": "boot.watchdog", "comparison": ">", "threshold": 0, "duration_secs": 0, "actions": ["ui"] },
    { "id": "cert-expiry", "enabled": true, "metric": "cert.*", "comparison": "<", "threshold": 30, "duration_secs": 0, "actions": ["ui"] }
  ]
}