{
  "platform": "pinnacle",
  "model": "nxp-imx8",
  "board_name": "NXP i.MX (Pinnacle) — multi-Ethernet, HMI, medical/industrial",
  "has_rtc": true,
  "has_tpm": true,
  "secure_boot": true,
  "service_allowlist": [
    "sshd.service",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "webconfigd.service",
    "weston.service",
    "node-red.service",
    "mosquitto.service"
  ],
  "peripherals": [
    {
      "id": "can0",
      "device": "can0",
      "human_name": "FlexCAN 0",
      "kind": "can",
      "caps": {
        "fd": true
      }
    },
    {
      "id": "can1",
      "device": "can1",
      "human_name": "FlexCAN 1",
      "kind": "can",
      "caps": {
        "fd": true
      }
    },
    {
      "id": "ttymxc0",
      "device": "/dev/ttymxc0",
      "human_name": "UART 0",
      "kind": "serial",
      "caps": {
        "modes": [
          "rs232",
          "rs485"
        ]
      }
    },
    {
      "id": "ttymxc1",
      "device": "/dev/ttymxc1",
      "human_name": "UART 1",
      "kind": "serial",
      "caps": {
        "modes": [
          "rs232"
        ]
      }
    },
    {
      "id": "i2c-0",
      "device": "/dev/i2c-0",
      "human_name": "I2C bus 0",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "i2c-1",
      "device": "/dev/i2c-1",
      "human_name": "I2C bus 1",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "i2c-2",
      "device": "/dev/i2c-2",
      "human_name": "I2C bus 2",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "spi0",
      "device": "/dev/spidev0.0",
      "human_name": "ECSPI 0",
      "kind": "spi",
      "caps": {}
    },
    {
      "id": "gpio-led-status",
      "device": "gpiochip0 line 0",
      "human_name": "Status LED",
      "kind": "gpio",
      "caps": {
        "direction": "out"
      }
    },
    {
      "id": "display-lvds0",
      "device": "/dev/dri/card0",
      "human_name": "LVDS display 0",
      "kind": "display",
      "caps": {
        "ports": [
          "lvds"
        ],
        "v2": "display-hmi"
      }
    },
    {
      "id": "thermal-zone-0",
      "device": "/sys/class/thermal/thermal_zone0",
      "human_name": "SoC thermal zone",
      "kind": "thermal",
      "caps": {
        "throttle": true
      }
    },
    {
      "id": "eth0",
      "device": "eth0",
      "human_name": "Ethernet 0",
      "kind": "net",
      "caps": {}
    },
    {
      "id": "eth1",
      "device": "eth1",
      "human_name": "Ethernet 1",
      "kind": "net",
      "caps": {}
    },
    {
      "id": "eth2",
      "device": "eth2",
      "human_name": "Ethernet 2",
      "kind": "net",
      "caps": {}
    }
  ],
  "dashboard_tiles": [
    {
      "id": "thermal",
      "title": "SoC temperature",
      "metrics": [
        "thermal.temp"
      ],
      "render": "sparkline"
    },
    {
      "id": "net",
      "title": "Multi-Ethernet links",
      "metrics": [
        "net.eth0",
        "net.eth1",
        "net.eth2"
      ],
      "render": "state"
    }
  ],
  "default_alert_rules": [
    { "id": "disk-full", "enabled": true, "metric": "disk.pct", "comparison": ">", "threshold": 90, "duration_secs": 60, "actions": ["ui"] },
    { "id": "watchdog-reset", "enabled": true, "metric": "boot.watchdog", "comparison": ">", "threshold": 0, "duration_secs": 0, "actions": ["ui"] },
    { "id": "cert-expiry", "enabled": true, "metric": "cert.*", "comparison": "<", "threshold": 30, "duration_secs": 0, "actions": ["ui"] }
  ]
}