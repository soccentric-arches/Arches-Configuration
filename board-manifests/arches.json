{
  "platform": "arches",
  "model": "nvidia-jetson",
  "board_name": "NVIDIA Jetson (Arches)",
  "has_rtc": true,
  "has_tpm": false,
  "secure_boot": true,
  "service_allowlist": [
    "sshd.service",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "webconfigd.service",
    "nvargus-daemon.service",
    "nvfancontrol.service",
    "nv_l4t_bootloader.service",
    "nvpmodel.service",
    "jetson_clocks.service"
  ],
  "peripherals": [
    {
      "id": "can0",
      "device": "can0",
      "human_name": "CAN channel 0",
      "kind": "can",
      "caps": {
        "fd": true,
        "termination_gpio": "gpio-can0-term"
      }
    },
    {
      "id": "ttyTHS0",
      "device": "/dev/ttyTHS0",
      "human_name": "High-speed UART 0",
      "kind": "serial",
      "caps": {
        "modes": [
          "rs232",
          "rs485"
        ]
      }
    },
    {
      "id": "ttyTHS1",
      "device": "/dev/ttyTHS1",
      "human_name": "High-speed UART 1",
      "kind": "serial",
      "caps": {
        "modes": [
          "rs232"
        ]
      }
    },
    {
      "id": "i2c-0",
      "device": "/dev/i2c-0",
      "human_name": "I2C bus 0 (gen1)",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "i2c-1",
      "device": "/dev/i2c-1",
      "human_name": "I2C bus 1 (gen1)",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "spi0",
      "device": "/dev/spidev0.0",
      "human_name": "SPI bus 0",
      "kind": "spi",
      "caps": {}
    },
    {
      "id": "gpio-led-system",
      "device": "gpiochip1 line 7",
      "human_name": "System status LED",
      "kind": "gpio",
      "caps": {
        "direction": "out",
        "active_low": false,
        "function": "led",
        "role": "system"
      }
    },
    {
      "id": "gpio-led-os",
      "device": "gpiochip1 line 8",
      "human_name": "OS status LED",
      "kind": "gpio",
      "caps": {
        "direction": "out",
        "active_low": false,
        "function": "led",
        "role": "os"
      }
    },
    {
      "id": "gpio-led-hardware",
      "device": "gpiochip1 line 9",
      "human_name": "Hardware status LED",
      "kind": "gpio",
      "caps": {
        "direction": "out",
        "active_low": false,
        "function": "led",
        "role": "hardware"
      }
    },
    {
      "id": "gpio-btn-recovery",
      "device": "gpiochip1 line 3",
      "human_name": "Recovery button",
      "kind": "gpio",
      "caps": {
        "direction": "in",
        "active_low": true
      }
    },
    {
      "id": "gpio-can0-term",
      "device": "gpiochip2 line 5",
      "human_name": "CAN0 termination",
      "kind": "gpio",
      "caps": {
        "direction": "out"
      }
    },
    {
      "id": "mcu-stm32",
      "device": "/dev/ttyACM0",
      "human_name": "STM32 companion MCU",
      "kind": "mcu",
      "caps": {
        "protocol": "soccentric-mcu",
        "signed_fw": true,
        "settings_schema": "app:mcu-stm32"
      }
    },
    {
      "id": "cam0",
      "device": "/dev/video0",
      "human_name": "MIPI CSI camera 0",
      "kind": "camera",
      "caps": {}
    },
    {
      "id": "cam1",
      "device": "/dev/video1",
      "human_name": "MIPI CSI camera 1",
      "kind": "camera",
      "caps": {}
    },
    {
      "id": "thermal-zone-0",
      "device": "/sys/class/thermal/thermal_zone0",
      "human_name": "GPU/A55 thermal zone",
      "kind": "thermal",
      "caps": {
        "throttle": true
      }
    },
    {
      "id": "eth0",
      "device": "eth0",
      "human_name": "Ethernet 0",
      "kind": "net",
      "caps": {}
    },
    {
      "id": "wlan0",
      "device": "wlan0",
      "human_name": "Wi-Fi",
      "kind": "net",
      "caps": {
        "ap": true
      }
    }
  ],
  "dashboard_tiles": [
    {
      "id": "gpu",
      "title": "GPU utilization",
      "metrics": [
        "gpu.util",
        "gpu.mem"
      ],
      "render": "sparkline"
    },
    {
      "id": "power-mode",
      "title": "Power mode (nvpmodel)",
      "metrics": [
        "arches.nvpmodel"
      ],
      "render": "value"
    },
    {
      "id": "fan",
      "title": "Fan RPM",
      "metrics": [
        "arches.fan_rpm"
      ],
      "render": "value"
    },
    {
      "id": "thermal",
      "title": "Thermal / throttle",
      "metrics": [
        "thermal.temp",
        "arches.throttled"
      ],
      "render": "state"
    },
    {
      "id": "mcu",
      "title": "STM32 heartbeat",
      "metrics": [
        "mcu.heartbeat",
        "mcu.fw_version"
      ],
      "render": "state"
    }
  ],
  "default_alert_rules": [
    { "id": "disk-full", "enabled": true, "metric": "disk.pct", "comparison": ">", "threshold": 90, "duration_secs": 60, "actions": ["ui"] },
    { "id": "watchdog-reset", "enabled": true, "metric": "boot.watchdog", "comparison": ">", "threshold": 0, "duration_secs": 0, "actions": ["ui"] },
    { "id": "throttling", "enabled": true, "metric": "temp.throttled", "comparison": ">", "threshold": 0, "duration_secs": 30, "actions": ["ui"] }
  ]
}